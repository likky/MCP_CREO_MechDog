.venv/
.tmp/
__pycache__/
*.egg-info/
build/
jobs/
*.lock
*.log

models/
config.json
seed_registry.json
# DEV-066: runtime session history remains local; preserve its existing path.
/session_activity.json
# BUG-120/D4.4: the resident panel session guard is local runtime state, like the
# Toolkit lock it sits beside; it names a live job and must never ship.
/panel_session_guard.json
/panel_session_guard.tmp
client-config.json
native/constants.inc
*.zip
*.sha256
# DEV-054 Q00: the 0.10.0 feedback archive keeps the recolor_assembly zip byte for byte.
!docs/validation/feedback-0.10.0-2026-11-01/originals/*.zip
# DEV-092: user-supplied SDK reference archive, explicitly requested on 2026-11-19.
!references/creo13.4.0.0-sdk/includes.zip
.pytest_cache/
.ruff_cache/
open_file/
# Local Creo session byproducts (DEV-064): erase evidence receipts, Toolkit logs
# and unsaved test models are kept on disk for forensics but never packaged or
# committed. Root-anchored so a future source directory cannot be swallowed.
/session_erase/
/trail.txt.*
/std.err
/std.out
examples/*.prt.*
# Local agent/IDE working data (plan snapshots, transcripts, caches). Not source,
# never packaged or committed, and kept out of style discovery so a regenerated
# snapshot cannot look like a source regression (DEV-059).
.codebuddy/
.workbuddy/
.zcode/
.trae/
# Runtime leftovers that sat next to the ignored lock and a one-off local plan
# input: neither is source, and neither is caught by the *.lock rule above.
toolkit-owner.lock.*.tmp
/underwater_plan.json
